{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AgeCivModTool",
  "version": "0.1.0",
  "identifier": "com.saysky.agecivmodtool",
  "build": {
    "beforeDevCommand": "dx serve --addr 0.0.0.0 --port 1420 --interactive false",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "(if exist dist rmdir /s /q dist) & (if exist target\\dx\\age-civ-mod-tool-ui\\release\\web\\public\\assets rmdir /s /q target\\dx\\age-civ-mod-tool-ui\\release\\web\\public\\assets) & dx bundle --release",
    "frontendDist": "../dist/public"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "AgeCivModTool",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
